{
  "name": "gaussian-viewer",
  "publisher": "GaussianViewer",
  "sponsor": {"url": "https://github.com/sponsors/reagan99"},
  "displayName": "GaussianViewer",
  "description": "View and edit 3D Gaussian Splat files (.ply, .splat, .gsplat) directly in VSCode with full SuperSplat editor integration",
  "version": "1.0.8",
  "icon": "logo.png",
  "files": [
    "out/**",
    "media/**",
    "images/**",
    "logo.png",
    "readme.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reagan99/GaussianViewer"
  },
  "bugs": {
    "url": "https://github.com/reagan99/GaussianViewer/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "3d",
    "gaussian",
    "splat",
    "ply",
    "3dgs",
    "point cloud",
    "viewer",
    "editor",
    "vscode"
  ],
  "activationEvents": [
    "onCustomEditor:supersplat.viewer",
    "onCommand:supersplat.viewpoint.copy",
    "onCommand:supersplat.viewpoint.save",
    "onCommand:supersplat.viewpoint.load",
    "onCommand:supersplat.camera.orbit.start",
    "onCommand:supersplat.camera.orbit.stop"
  ],
  "main": "./out/optimizedExtension.js",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "supersplat.viewer",
        "displayName": "SuperSplat Viewer",
        "selector": [
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.splat"
          },
          {
            "filenamePattern": "*.gsplat"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "supersplat.performance.showStats",
        "title": "GaussianViewer: Show Performance Stats"
      },
      {
        "command": "supersplat.performance.clearCache",
        "title": "GaussianViewer: Clear Cache"
      },
      {
        "command": "supersplat.performance.optimizeFile",
        "title": "GaussianViewer: Optimize Current PLY"
      },
      {
        "command": "supersplat.performance.preloadFile",
        "title": "GaussianViewer: Preload PLY"
      },
      {
        "command": "supersplat.performance.contextOptimize",
        "title": "GaussianViewer: Preload/Optimize PLY"
      },
      {
        "command": "supersplat.performance.batchOptimize",
        "title": "GaussianViewer: Batch Optimize Workspace PLY Files"
      },
      {
        "command": "supersplat.performance.resetConfig",
        "title": "GaussianViewer: Reset Performance Settings"
      },
      {
        "command": "supersplat.viewpoint.copy",
        "title": "GaussianViewer: Copy Current Viewpoint"
      },
      {
        "command": "supersplat.viewpoint.save",
        "title": "GaussianViewer: Save Current Viewpoint"
      },
      {
        "command": "supersplat.viewpoint.load",
        "title": "GaussianViewer: Load Viewpoint"
      },
      {
        "command": "supersplat.camera.orbit.start",
        "title": "GaussianViewer: Start Cinematic Orbit"
      },
      {
        "command": "supersplat.camera.orbit.stop",
        "title": "GaussianViewer: Stop Cinematic Orbit"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "supersplat.performance.contextOptimize",
          "when": "resourceExtname == .ply",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VSCode SuperSplat",
      "properties": {
        "supersplat.backgroundColor": {
          "type": "string",
          "default": "#121212",
          "description": "Default background color for the viewer."
        },
        "supersplat.enableEditing": {
          "type": "boolean",
          "default": true,
          "description": "Enable editing capabilities in the viewer."
        },
        "supersplat.showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show grid helper in the viewer."
        },
        "supersplat.showAxes": {
          "type": "boolean",
          "default": true,
          "description": "Show axes helper in the viewer."
        },
        "supersplat.performance.enableASCIIToBinaryConversion": {
          "type": "boolean",
          "default": true,
          "description": "Automatically convert ASCII PLY files to binary format for faster loading"
        },
        "supersplat.performance.enablePLYCaching": {
          "type": "boolean",
          "default": true,
          "description": "Cache converted PLY files to avoid re-processing"
        },
        "supersplat.performance.largeFileThreshold": {
          "type": "number",
          "default": 10,
          "description": "File size threshold in MB for using optimized transfer methods"
        },
        "supersplat.performance.chunkSize": {
          "type": "number",
          "default": 8388608,
          "description": "Default chunk size in bytes for large file transfer"
        },
        "supersplat.performance.enableDirectUriTransfer": {
          "type": "boolean",
          "default": true,
          "description": "Use direct webview file URIs when possible"
        },
        "supersplat.performance.enablePerformanceLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable performance metrics logging"
        },
        "supersplat.performance.enableGarbageCollection": {
          "type": "boolean",
          "default": true,
          "description": "Periodically prune stale or oversized PLY cache files"
        },
        "supersplat.performance.cacheMaxAge": {
          "type": "number",
          "default": 86400000,
          "description": "Maximum age of cached optimized PLY files in milliseconds"
        },
        "supersplat.performance.maxCacheSize": {
          "type": "number",
          "default": 500,
          "description": "Maximum PLY cache size in MB before older cache files are pruned"
        },
        "supersplat.performance.gcInterval": {
          "type": "number",
          "default": 300000,
          "description": "Interval in milliseconds for pruning stale PLY cache files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'Pre-compiled optimized version ready'",
    "compile": "echo 'Using pre-compiled JavaScript files'",
    "watch": "echo 'Using pre-compiled JavaScript files'",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.5",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "glob": "^11.0.1",
    "mocha": "^11.0.1",
    "typescript": "^5.8.3",
    "vsce": "^2.15.0",
    "vscode-test": "^1.6.1"
  }
}
